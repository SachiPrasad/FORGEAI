# Copy this file to .env and configure your preferred LLM provider credentials.
# Leave unset to run FORGEAI in deterministic offline mode.

# OpenAI (default: gpt-4o-mini or openai/o3)
# OPENAI_API_KEY=sk-...

# Optional alternative providers supported via LiteLLM:
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=...
# TAVILY_API_KEY=tvly-...

# Optional FORGEAI overrides
# FORGEAI_MODEL=gpt-4o-mini
# FORGEAI_LOG_DIR=logs

